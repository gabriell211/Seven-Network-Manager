{
  "paths": {
    "/sites/{siteId}/ipam/prefixes": {
      "get": {
        "operationId": "listIpamPrefixes",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "siteId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
          { "name": "routingDomainId", "in": "query", "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": { "description": "Scoped IPAM prefixes", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/IpPrefix" } } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      },
      "post": {
        "operationId": "createIpamPrefix",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "siteId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/NewIpPrefix" } } } },
        "responses": {
          "201": { "description": "Created prefix", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/IpPrefix" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "422": { "description": "Invalid prefix", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } }
        }
      }
    },
    "/sites/{siteId}/ipam/prefixes/{prefixId}": {
      "patch": {
        "operationId": "updateIpamPrefix",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "siteId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
          { "name": "prefixId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdateIpPrefix" } } } },
        "responses": {
          "200": { "description": "Updated prefix", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/IpPrefix" } } } },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      },
      "delete": {
        "operationId": "deleteIpamPrefix",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "siteId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
          { "name": "prefixId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DeleteVersionRequest" } } } },
        "responses": {
          "204": { "description": "Prefix deleted" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/sites/{siteId}/ipam/addresses": {
      "get": {
        "operationId": "listIpamAddresses",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "siteId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
          { "name": "routingDomainId", "in": "query", "schema": { "type": "string", "format": "uuid" } },
          { "name": "prefixId", "in": "query", "schema": { "type": "string", "format": "uuid" } },
          { "name": "state", "in": "query", "schema": { "$ref": "#/components/schemas/AddressState" } },
          { "name": "search", "in": "query", "schema": { "type": "string" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 200, "default": 100 } },
          { "name": "offset", "in": "query", "schema": { "type": "integer", "minimum": 0, "default": 0 } }
        ],
        "responses": {
          "200": { "description": "Scoped IP allocations", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/IpAddress" } } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      },
      "post": {
        "operationId": "createIpamAddress",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "siteId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/NewIpAddress" } } } },
        "responses": {
          "201": { "description": "Created allocation", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/IpAddress" } } } },
          "409": { "$ref": "#/components/responses/Conflict" },
          "422": { "description": "Invalid allocation", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } }
        }
      }
    },
    "/sites/{siteId}/ipam/addresses/{addressId}": {
      "patch": {
        "operationId": "updateIpamAddress",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "siteId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
          { "name": "addressId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdateIpAddress" } } } },
        "responses": {
          "200": { "description": "Updated allocation", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/IpAddress" } } } },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      },
      "delete": {
        "operationId": "deleteIpamAddress",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "siteId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
          { "name": "addressId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DeleteVersionRequest" } } } },
        "responses": {
          "204": { "description": "Allocation deleted" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    }
  },
  "schemas": {
    "RoutingDomain": {
      "type": "object",
      "required": ["id", "name", "isDefault"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "name": { "type": "string" },
        "isDefault": { "type": "boolean" }
      }
    },
    "SiteContext": {
      "type": "object",
      "required": ["id", "slug", "name", "timezone", "defaultRoutingDomain", "routingDomains", "permissions"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "slug": { "type": "string" },
        "name": { "type": "string" },
        "timezone": { "type": "string" },
        "defaultRoutingDomain": { "anyOf": [{ "$ref": "#/components/schemas/RoutingDomain" }, { "type": "null" }] },
        "routingDomains": { "type": "array", "items": { "$ref": "#/components/schemas/RoutingDomain" } },
        "permissions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "AddressState": {
      "type": "string",
      "enum": ["available", "reserved", "assigned", "observed", "conflict", "excluded"]
    },
    "PrefixCapacity": {
      "type": "object",
      "required": ["totalAddresses", "allocatedAddresses", "utilizationPercent"],
      "properties": {
        "totalAddresses": { "type": "string" },
        "allocatedAddresses": { "type": "integer" },
        "utilizationPercent": { "type": "number" }
      }
    },
    "IpPrefix": {
      "type": "object",
      "required": ["id", "organizationId", "siteId", "routingDomainId", "prefix", "version", "createdAt", "updatedAt", "capacity"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "organizationId": { "type": "string", "format": "uuid" },
        "siteId": { "type": "string", "format": "uuid" },
        "routingDomainId": { "type": "string", "format": "uuid" },
        "prefix": { "type": "string" },
        "name": { "type": ["string", "null"] },
        "gateway": { "type": ["string", "null"] },
        "vlanId": { "type": ["integer", "null"] },
        "description": { "type": ["string", "null"] },
        "purpose": { "type": ["string", "null"] },
        "version": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "capacity": { "$ref": "#/components/schemas/PrefixCapacity" }
      }
    },
    "NewIpPrefix": {
      "type": "object",
      "required": ["routingDomainId", "prefix"],
      "properties": {
        "routingDomainId": { "type": "string", "format": "uuid" },
        "prefix": { "type": "string" },
        "name": { "type": ["string", "null"] },
        "gateway": { "type": ["string", "null"] },
        "vlanId": { "type": ["integer", "null"] },
        "description": { "type": ["string", "null"] },
        "purpose": { "type": ["string", "null"] }
      }
    },
    "UpdateIpPrefix": {
      "type": "object",
      "required": ["expectedVersion", "routingDomainId", "prefix"],
      "properties": {
        "expectedVersion": { "type": "integer" },
        "routingDomainId": { "type": "string", "format": "uuid" },
        "prefix": { "type": "string" },
        "name": { "type": ["string", "null"] },
        "gateway": { "type": ["string", "null"] },
        "vlanId": { "type": ["integer", "null"] },
        "description": { "type": ["string", "null"] },
        "purpose": { "type": ["string", "null"] }
      }
    },
    "DeleteVersionRequest": {
      "type": "object",
      "required": ["expectedVersion"],
      "properties": { "expectedVersion": { "type": "integer" } }
    },
    "IpAddress": {
      "type": "object",
      "required": ["id", "organizationId", "siteId", "routingDomainId", "address", "state", "source", "version", "createdAt", "updatedAt"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "organizationId": { "type": "string", "format": "uuid" },
        "siteId": { "type": "string", "format": "uuid" },
        "routingDomainId": { "type": "string", "format": "uuid" },
        "prefixId": { "type": ["string", "null"], "format": "uuid" },
        "deviceId": { "type": ["string", "null"], "format": "uuid" },
        "interfaceId": { "type": ["string", "null"], "format": "uuid" },
        "address": { "type": "string" },
        "dnsName": { "type": ["string", "null"] },
        "state": { "$ref": "#/components/schemas/AddressState" },
        "source": { "type": "string" },
        "description": { "type": ["string", "null"] },
        "version": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "NewIpAddress": {
      "type": "object",
      "required": ["routingDomainId", "prefixId", "address", "state", "source"],
      "properties": {
        "routingDomainId": { "type": "string", "format": "uuid" },
        "prefixId": { "type": "string", "format": "uuid" },
        "deviceId": { "type": ["string", "null"], "format": "uuid" },
        "interfaceId": { "type": ["string", "null"], "format": "uuid" },
        "address": { "type": "string" },
        "dnsName": { "type": ["string", "null"] },
        "state": { "$ref": "#/components/schemas/AddressState" },
        "source": { "type": "string" },
        "description": { "type": ["string", "null"] }
      }
    },
    "UpdateIpAddress": {
      "type": "object",
      "required": ["expectedVersion", "state", "source"],
      "properties": {
        "expectedVersion": { "type": "integer" },
        "deviceId": { "type": ["string", "null"], "format": "uuid" },
        "interfaceId": { "type": ["string", "null"], "format": "uuid" },
        "dnsName": { "type": ["string", "null"] },
        "state": { "$ref": "#/components/schemas/AddressState" },
        "source": { "type": "string" },
        "description": { "type": ["string", "null"] }
      }
    }
  }
}
