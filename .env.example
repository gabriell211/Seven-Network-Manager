# Copy only as a reference. Prefer: python3 scripts/bootstrap_env.py
SNM_ENV=development
SNM_DEPLOYMENT_ENV=development
SNM_BACKEND_BIND=127.0.0.1:8080
SNM_RUNTIME_URL=http://127.0.0.1:9765
SNM_RUNTIME_BIND=127.0.0.1:9765
SNM_RUNTIME_TOKEN=__GENERATE_LOCAL_SECRET__
SNM_RUNTIME_ALLOW_PUBLIC_TARGETS=false
SNM_RUNTIME_ALLOW_NON_LOOPBACK=false
SNM_RUN_MIGRATIONS=true
SNM_DATABASE_MAX_CONNECTIONS=10
SNM_ACCESS_TOKEN_KEY=__GENERATE_DISTINCT_LOCAL_SECRET__
SNM_AUTH_ISSUER=snm
SNM_AUTH_AUDIENCE=snm-api
SNM_AUTH_COOKIE_SECURE=false

# Observability is local JSON only by default. OTLP is opt-in and must never be
# required for backend/runtime readiness.
SNM_OTEL_ENABLED=false
SNM_OTEL_EXPORT_TIMEOUT_MS=5000
# SNM_INSTANCE_ID=stable-instance-name
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

# Optional one-shot on-prem bootstrap. Set these only for the first controlled startup.
# SNM_BOOTSTRAP_ORG_SLUG=example
# SNM_BOOTSTRAP_ORG_NAME=Example Organization
# SNM_BOOTSTRAP_SITE_SLUG=default
# SNM_BOOTSTRAP_SITE_NAME=Default Site
# SNM_BOOTSTRAP_ADMIN_EMAIL=admin@example.invalid
# SNM_BOOTSTRAP_ADMIN_NAME=SNM Administrator
# SNM_BOOTSTRAP_ADMIN_PASSWORD=__SET_A_STRONG_ONE_TIME_PASSWORD__
DATABASE_URL=postgres://snm:__GENERATE_LOCAL_SECRET__@127.0.0.1:5432/snm
REDIS_URL=redis://127.0.0.1:6379/0
SNM_API_BASE_URL=http://127.0.0.1:8080
POSTGRES_USER=snm
POSTGRES_PASSWORD=__GENERATE_LOCAL_SECRET__
POSTGRES_DB=snm
MONGO_INITDB_ROOT_USERNAME=snm
MONGO_INITDB_ROOT_PASSWORD=__GENERATE_LOCAL_SECRET__
